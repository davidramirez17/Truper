@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  color-scheme: light;
  --page:#f7f8fa; --surface:#fff; --surface-subtle:#f9fafb; --text:#22252b; --muted:#707680; --subtle:#9097a1; --border:#e9eaed; --border-strong:#d9dce1;
  --accent:#ed701b; --accent-hover:#d65c09; --accent-ink:#a64308; --accent-soft:#fff3e9; --accent-border:#ffe2cc; --green:#13795b; --green-soft:#eaf7f1;
  --blue:#4274b3; --blue-soft:#edf3ff; --purple:#7b61ad; --purple-soft:#f1edfa; --amber:#926017; --amber-soft:#fff7e8; --red:#b83939; --red-soft:#fff0ef; --chart-muted:#c3c9cf;
  --sidebar:#202329; --sidebar-text:#bdc0c6; --sidebar-muted:#9297a0; --sidebar-border:#363940; --sidebar-hover:#2e3137; --white:#fff;
  --shadow:0 2px 3px #1e293b02; --dialog-shadow:0 24px 100px #0003; --overlay:#161c2f70; --radius:.8rem; --sidebar-width:14.5rem;
}
[data-theme='dark'] { color-scheme:dark; --page:#16191e; --surface:#20242b; --surface-subtle:#252a32; --text:#edf0f5; --muted:#a4acb9; --subtle:#929aa7; --border:#343942; --border-strong:#494e59; --accent:#f78a3c; --accent-hover:#ffa361; --accent-ink:#ffae76; --accent-soft:#392b23; --accent-border:#634330; --green:#71d4aa; --green-soft:#22372f; --blue:#98bcf1; --blue-soft:#273349; --purple:#c1a8f1; --purple-soft:#362e47; --amber:#efbf73; --amber-soft:#3a3023; --red:#ffa5a0; --red-soft:#432c2c; --chart-muted:#65707e; }
* { box-sizing:border-box; }
body { margin:0; background:var(--page); color:var(--text); font-family:'Inter Variable',sans-serif; font-size:.8125rem; -webkit-font-smoothing:antialiased; }
button,input,select { font:inherit; } button,a { touch-action:manipulation; -webkit-tap-highlight-color:transparent; } button { cursor:pointer; border:0; } button:disabled { opacity:.45; cursor:not-allowed; }
a { color:inherit; text-decoration:none; } button,a,input,select,summary { outline-offset:4px; } :focus-visible { outline:3px solid var(--accent); }
::selection { background:var(--accent-border); color:var(--text); } h1,h2,h3,p { margin:0; } h1,h2,h3 { font-family:'Manrope Variable',sans-serif; } svg { flex-shrink:0; }
.app-shell { min-height:100vh; } .skip-link { position:fixed; top:-5rem; left:1rem; z-index:100; padding:1rem; background:var(--surface); border:2px solid var(--accent); } .skip-link:focus { top:1rem; }
.sidebar { position:fixed; inset:0 auto 0 0; z-index:30; width:var(--sidebar-width); background:var(--sidebar); color:var(--sidebar-text); padding:1.6rem 1rem 0; display:flex; flex-direction:column; overflow-y:auto; }
.brand { display:flex; align-items:center; gap:.65rem; padding:0 .5rem; color:var(--white); margin-bottom:2rem; }
.brand-mark { font-size:1.55rem; font-weight:900; font-style:italic; width:2.05rem; height:2.05rem; display:grid; place-items:center; background:var(--accent); border-radius:.35rem; line-height:1; }
.brand b { font-family:'Manrope Variable',sans-serif; font-size:1.4rem; letter-spacing:.075em; font-weight:850; line-height:1.1; } .brand-period { color:var(--accent); } .brand small { display:block; font-size:.455rem; letter-spacing:.19em; margin-top:.3rem; color:var(--sidebar-text); }
.workspace-switch { border:1px solid var(--sidebar-border); display:flex; align-items:center; gap:.65rem; border-radius:.5rem; padding:.7rem .65rem; margin-bottom:1.8rem; }
.workspace-avatar { display:grid; place-items:center; width:1.9rem; height:1.9rem; border-radius:.35rem; background:var(--sidebar-hover); font-size:.65rem; color:var(--white); font-weight:650; }
.workspace-switch strong { font-weight:560; display:block; color:var(--white); font-size:.71rem; } .workspace-switch div>span { color:var(--sidebar-muted); display:block; font-size:.58rem; margin-top:.18rem; } .workspace-dot { width:.36rem; height:.36rem; border-radius:50%; background:var(--accent); margin-left:auto; }
.nav-group-label { color:var(--sidebar-muted); font-size:.53rem; letter-spacing:.13em; font-weight:650; padding-left:.75rem; margin-bottom:.75rem; }
.nav-item { width:100%; display:flex; gap:.72rem; align-items:center; text-align:left; min-height:2.7rem; padding:.72rem .8rem; border-radius:.42rem; font-size:.74rem; color:var(--sidebar-text); background:transparent; margin-bottom:.2rem; transition:background .15s,color .15s; }
.nav-item:hover { background:var(--sidebar-hover); color:var(--white); } .nav-item[aria-current='page'] { background:var(--accent); color:var(--white); font-weight:570; }
.nav-count { margin-left:auto; display:grid; place-items:center; width:1.1rem; height:1.1rem; border-radius:.25rem; background:var(--sidebar-hover); color:var(--white); font-size:.56rem; }
.sidebar-bottom { margin-top:auto; padding-top:3rem; } .sidebar-note { background:linear-gradient(130deg,var(--sidebar-hover),var(--sidebar)); border:1px solid var(--sidebar-border); border-radius:.7rem; padding:1rem .9rem; margin-bottom:1rem; }
.small-orbit { color:var(--accent); margin-bottom:.75rem; display:block; } .sidebar-note strong { color:var(--white); font-family:'Manrope Variable',sans-serif; font-size:.74rem; font-weight:640; display:block; } .sidebar-note p { color:var(--sidebar-muted); font-size:.65rem; line-height:1.75; margin:.55rem 0 .8rem; } .sidebar-note button { display:flex; align-items:center; gap:.7rem; background:transparent; color:var(--sidebar-text); padding:0; font-size:.65rem; }
.help-nav>svg:last-child { margin-left:auto; } .sidebar-profile { margin-top:.9rem; border-top:1px solid var(--sidebar-border); padding:1rem .3rem; display:flex; align-items:center; gap:.55rem; } .profile-avatar { display:grid; place-items:center; background:var(--sidebar-hover); color:var(--white); width:2rem; height:2rem; border-radius:50%; font-size:.65rem; } .sidebar-profile strong { color:var(--white); font-size:.67rem; font-weight:500; display:block; } .sidebar-profile small { display:block; font-size:.51rem; color:var(--sidebar-muted); margin-top:.2rem; } .online-dot { width:.34rem; height:.34rem; border-radius:50%; background:var(--green); margin-left:auto; }
.workspace-main { margin-left:var(--sidebar-width); min-width:0; } .topbar { height:4.35rem; background:var(--surface); border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; padding:0 2.1rem; gap:1rem; }
.breadcrumb { display:flex; align-items:center; gap:.8rem; font-size:.67rem; font-weight:550; } .breadcrumb-home { color:var(--muted); font-weight:400; } .topbar-actions { display:flex; align-items:center; gap:.65rem; }
.global-search { display:flex; align-items:center; gap:.6rem; padding:.45rem .65rem; background:var(--surface-subtle); border:1px solid var(--border); border-radius:.42rem; color:var(--muted); font-size:.62rem; } kbd { display:flex; align-items:center; gap:.15rem; background:var(--surface); border:1px solid var(--border); border-radius:.2rem; padding:.13rem .25rem; margin-left:2rem; font:inherit; font-size:.55rem; }
.topbar-divider { height:1.3rem; width:1px; background:var(--border); margin:0 .35rem; } .icon-button { display:inline-flex; align-items:center; justify-content:center; flex-shrink:0; min-width:2rem; min-height:2rem; border-radius:.4rem; background:transparent; color:var(--muted); transition:background .15s; } .icon-button:hover { background:var(--surface-subtle); color:var(--text); }
.notification-button { position:relative; } .notification-button i { width:.32rem; height:.32rem; position:absolute; top:.35rem; right:.45rem; border-radius:50%; background:var(--accent); border:1px solid var(--surface); } .topbar-avatar { display:grid; place-items:center; width:2rem; height:2rem; border-radius:50%; border:3px solid var(--surface); outline:1px solid var(--border); background:var(--accent-soft); color:var(--accent-ink); font-size:.6rem; font-weight:600; margin-left:.3rem; } .mobile-menu { display:none; }
.content { max-width:106rem; padding:1.35rem 2.1rem 1.3rem; margin:auto; } .mode-banner { display:flex; align-items:center; justify-content:space-between; gap:.6rem; border:1px solid var(--accent-border); background:var(--accent-soft); border-radius:.45rem; padding:.62rem .9rem; color:var(--accent-ink); font-size:.625rem; margin-bottom:1.75rem; } .mode-banner>span { display:flex; gap:.55rem; align-items:center; } .mode-banner strong { font-weight:650; } .mode-description { color:var(--muted); padding-left:.6rem; border-left:1px solid var(--accent-border); } .mode-banner button { display:flex; align-items:center; gap:.55rem; background:none; color:inherit; font-weight:600; white-space:nowrap; } .mode-real { background:var(--blue-soft); border-color:var(--border); color:var(--blue); } .mode-local { background:var(--green-soft); border-color:var(--border); color:var(--green); }
.page-heading { display:flex; justify-content:space-between; align-items:center; gap:1.5rem; margin-bottom:1.9rem; } .eyebrow { font-size:.54rem; letter-spacing:.14em; color:var(--muted); font-weight:620; margin-bottom:.55rem; } h1 { font-size:clamp(1.7rem,2.2vw,2.3rem); letter-spacing:-.047em; font-weight:720; line-height:1.25; } .page-description { color:var(--muted); font-size:.72rem; line-height:1.8; margin-top:.6rem; max-width:43rem; } .heading-actions { display:flex; gap:.6rem; flex-shrink:0; }
.button { display:inline-flex; align-items:center; justify-content:center; gap:.45rem; border-radius:.45rem; min-height:2.45rem; padding:.7rem .9rem; font-size:.66rem; font-weight:570; transition:background .15s,transform .15s; white-space:nowrap; } .button:active:not(:disabled) { transform:translateY(1px); } .primary { color:var(--white); background:var(--accent); border:1px solid var(--accent); } .primary:hover:not(:disabled) { background:var(--accent-hover); } .secondary { color:var(--text); background:var(--surface); border:1px solid var(--border-strong); } .secondary:hover:not(:disabled) { background:var(--surface-subtle); } .small { min-height:2rem; font-size:.62rem; padding:.45rem .7rem; } .text-button { display:inline-flex; align-items:center; gap:.4rem; color:var(--accent-ink); background:none; font-size:.66rem; font-weight:600; padding:.25rem 0; } .text-button:hover { text-decoration:underline; text-underline-offset:.2rem; }
.filter-bar { display:flex; justify-content:space-between; align-items:center; gap:.8rem; padding-bottom:1.3rem; margin-bottom:1.3rem; border-bottom:1px solid var(--border); } .filter-controls { display:flex; gap:.55rem; align-items:center; flex-wrap:wrap; } .select-control { display:flex; align-items:center; gap:.5rem; border:1px solid var(--border); padding:.2rem .65rem; border-radius:.4rem; background:var(--surface); color:var(--muted); } .select-control select { appearance:none; min-height:1.75rem; background:none; border:none; color:var(--text); cursor:pointer; font-size:.63rem; max-width:11rem; } option { color:var(--text); background:var(--surface); } .date-range { color:var(--muted); font-size:.6rem; margin-left:.35rem; } .refresh-control { display:flex; align-items:center; color:var(--muted); font-size:.6rem; gap:.4rem; white-space:nowrap; } .status-dot { width:.3rem; height:.3rem; border-radius:50%; background:var(--green); }
.view-content { display:grid; gap:1.15rem; transition:opacity .2s; } .view-pending { opacity:.55; pointer-events:none; } .metrics-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.95rem; } .metric-card { position:relative; min-width:0; border:1px solid var(--border); border-radius:var(--radius); padding:1.1rem 1.1rem .95rem; background:var(--surface); box-shadow:var(--shadow); overflow:hidden; } .metric-primary { border-color:var(--accent-border); background:linear-gradient(130deg,var(--surface) 35%,var(--accent-soft)); } .metric-label { display:flex; justify-content:space-between; align-items:center; font-size:.62rem; color:var(--muted); gap:.4rem; } .metric-label svg { color:var(--subtle); width:1rem; } .metric-primary .metric-label svg { color:var(--accent); }
.metric-value { display:block; font-family:'Manrope Variable',sans-serif; font-size:clamp(1.35rem,1.85vw,2.05rem); font-weight:720; letter-spacing:-.04em; line-height:1.5; margin:.55rem 0; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; position:relative; z-index:1; } .metric-bottom { display:flex; align-items:center; gap:.3rem; font-size:.51rem; color:var(--muted); position:relative; z-index:1; } .metric-change { display:inline-flex; align-items:center; gap:.1rem; color:var(--green); background:var(--green-soft); border-radius:.25rem; padding:.18rem .27rem; font-size:.53rem; font-weight:600; } .metric-change.negative { color:var(--red); background:var(--red-soft); } .metric-detail-dot { width:.28rem; height:.28rem; border-radius:50%; background:var(--subtle); } .metric-spark { width:4rem; position:absolute; right:-.3rem; bottom:1rem; opacity:.16; color:var(--accent); }
.analytics-grid,.operations-grid { display:grid; grid-template-columns:minmax(0,2.1fr) minmax(15rem,1fr); gap:1.1rem; } .panel { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); box-shadow:var(--shadow); min-width:0; } .panel-heading { display:flex; justify-content:space-between; gap:1rem; align-items:flex-start; padding:1.25rem 1.25rem 1rem; } .panel-heading h2 { font-size:.86rem; font-weight:750; letter-spacing:-.02em; } .panel-heading p { color:var(--muted); font-size:.61rem; line-height:1.6; margin-top:.32rem; } .chip { display:inline-flex; align-items:center; border:1px solid var(--border); background:var(--surface-subtle); color:var(--muted); border-radius:.3rem; font-size:.56rem; padding:.32rem .55rem; white-space:nowrap; }
.chart-summary { padding:.15rem 1.3rem 1.05rem; display:flex; justify-content:space-between; align-items:center; gap:1rem; } .chart-summary>strong { font-family:'Manrope Variable',sans-serif; letter-spacing:-.035em; font-size:1.7rem; font-weight:700; } .chart-legend { display:flex; gap:.85rem; color:var(--muted); font-size:.52rem; } .chart-legend span { display:flex; align-items:center; gap:.3rem; } .chart-legend i { height:.32rem; width:.32rem; border-radius:50%; } .legend-current { background:var(--accent); } .legend-previous { background:var(--chart-muted); } .chart-wrap { padding:0 .8rem .85rem; } .sales-chart { width:100%; height:auto; overflow:visible; } .sales-chart text { font-family:'Inter Variable',sans-serif; font-size:10px; fill:var(--muted); } .chart-grid { stroke:var(--border); stroke-dasharray:3 4; } .chart-caption { min-height:1.2rem; text-align:right; color:var(--muted); padding:.3rem .5rem 0; font-size:.5rem; } .chart-data { margin:.5rem .5rem 0; color:var(--muted); font-size:.55rem; } .chart-data summary { cursor:pointer; width:fit-content; } .chart-data .table-scroll { max-height:15rem; margin-top:.7rem; } .chart-empty { min-height:15rem; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:.7rem; color:var(--muted); padding:2rem; text-align:center; } .chart-empty strong { color:var(--text); font-size:.85rem; } .chart-empty p { max-width:23rem; line-height:1.8; font-size:.7rem; } .empty-chart-icon { font-size:2rem; color:var(--accent); background:var(--accent-soft); border-radius:50%; width:3.5rem; height:3.5rem; display:grid; place-items:center; }
.region-total { margin:.25rem 1.25rem .7rem; display:flex; justify-content:space-between; color:var(--muted); font-size:.57rem; } .region-total span:last-child { font-size:.46rem; letter-spacing:.065em; } .region-list { display:grid; gap:.8rem; padding:0 1.25rem; } .region>div:first-child { display:flex; justify-content:space-between; align-items:center; font-size:.61rem; } .region>div>span { display:flex; align-items:center; gap:.45rem; } .region strong { font-variant-numeric:tabular-nums; font-size:.65rem; } .region strong small { color:var(--muted); margin-left:.1rem; font-weight:450; } .region>small { font-size:.5rem; color:var(--muted); display:block; margin-top:.27rem; } .region-dot { width:.3rem; height:.3rem; border-radius:50%; } .region-track { height:.28rem; background:var(--surface-subtle); border-radius:1rem; margin-top:.4rem; } .region-fill { display:block; height:100%; border-radius:1rem; } .region-0 { background:var(--accent); }.region-1 { background:var(--blue); }.region-2 { background:var(--green); }.region-3 { background:var(--purple); }.region-4 { background:var(--amber); } .panel-footnote { display:flex; align-items:center; gap:.3rem; font-size:.49rem; color:var(--muted); margin:1rem 1.25rem .95rem; padding-top:.6rem; border-top:1px solid var(--border); }
.table-scroll { overflow-x:auto; max-width:100%; } table { width:100%; border-collapse:collapse; text-align:left; white-space:nowrap; font-size:.66rem; } th { background:var(--surface-subtle); color:var(--muted); font-size:.49rem; letter-spacing:.06em; font-weight:500; padding:.75rem 1.1rem; } td { border-top:1px solid var(--border); padding:1rem 1.1rem; } tbody tr:hover { background:var(--surface-subtle); } .project-name { display:flex; align-items:center; gap:.65rem; } .project-name strong { display:block; font-weight:550; font-size:.65rem; } .project-name small { display:block; color:var(--muted); font-size:.51rem; margin-top:.25rem; } .project-icon { width:2.25rem; height:2.25rem; border-radius:.5rem; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0; } .color-orange { background:var(--accent-soft); color:var(--accent); }.color-blue { background:var(--blue-soft); color:var(--blue); }.color-purple { background:var(--purple-soft); color:var(--purple); }
.badge { display:inline-flex; align-items:center; justify-content:center; gap:.3rem; padding:.25rem .45rem; border-radius:.3rem; white-space:nowrap; font-size:.5rem; font-weight:540; } .badge i { width:.22rem; height:.22rem; border-radius:50%; background:currentColor; } .badge-ready { color:var(--green); background:var(--green-soft); }.badge-attention { color:var(--amber); background:var(--amber-soft); }.badge-planned,.badge-unconfigured { color:var(--muted); background:var(--surface-subtle); } .amount { font-variant-numeric:tabular-nums; font-weight:550; } .table-date { color:var(--muted); font-size:.59rem; } .projects-table th,.projects-table td { padding-left:.9rem; padding-right:.7rem; } .projects-table td:first-child { padding-left:1.25rem; } .projects-table th:nth-child(3) { font-size:.45rem; }
.focus-card { position:relative; overflow:hidden; background:var(--sidebar); border:1px solid var(--sidebar-border); border-radius:var(--radius); color:var(--white); padding:1.3rem 1.25rem 2.7rem; } .focus-label { display:flex; justify-content:space-between; color:var(--sidebar-text); align-items:center; font-size:.47rem; letter-spacing:.07em; } .focus-label>span:first-child { display:flex; gap:.5rem; align-items:center; } .focus-label svg { color:var(--accent); } .focus-live { width:.3rem; height:.3rem; border-radius:50%; background:var(--accent); box-shadow:0 0 0 4px var(--sidebar-hover); } .focus-card h2 { position:relative; z-index:1; font-size:1.25rem; line-height:1.35; font-weight:570; letter-spacing:-.035em; margin-top:1.3rem; max-width:13rem; } .focus-card p { position:relative; z-index:1; font-size:.61rem; line-height:1.85; margin-top:.7rem; color:var(--sidebar-text); max-width:17rem; } .focus-card>a { display:inline-flex; align-items:center; gap:1rem; position:relative; z-index:2; font-size:.65rem; font-weight:550; color:var(--accent); margin-top:1rem; } .focus-decoration { position:absolute; display:flex; gap:.55rem; align-items:flex-end; right:-.5rem; bottom:-.5rem; width:9rem; height:3.5rem; opacity:.2; transform:rotate(-10deg); } .focus-decoration span { flex:1; height:30%; background:var(--accent); border-radius:.25rem .25rem 0 0; }.focus-decoration span:nth-child(2) { height:40%; }.focus-decoration span:nth-child(3) { height:55%; }.focus-decoration span:nth-child(4) { height:45%; }.focus-decoration span:nth-child(5) { height:70%; }.focus-decoration span:nth-child(6) { height:80%; }.focus-decoration span:nth-child(7) { height:100%; }
.quick-strip { border:1px solid var(--border); border-radius:.65rem; padding:.95rem 1.1rem; display:flex; gap:.8rem; align-items:center; } .quick-icon { color:var(--muted); }.quick-strip strong { font-size:.65rem; font-weight:570; }.quick-strip p { color:var(--muted); font-size:.56rem; margin-top:.25rem; line-height:1.6; }.quick-strip .text-button { margin-left:auto; white-space:nowrap; } .page-footer { display:flex; justify-content:space-between; gap:1rem; margin-top:1.5rem; padding-top:.5rem; font-size:.51rem; color:var(--muted); }.page-footer>span { display:flex; gap:.45rem; align-items:center; }.page-footer i { width:.16rem; height:.16rem; background:var(--subtle); border-radius:50%; margin:0 .2rem; }.footer-mark { font-weight:850; font-style:italic; font-size:.72rem; color:var(--subtle); }

/* ==========================================================
   TRUPER MOBILE APP SHELL
   ========================================================== */

.mobile-dock-shell {
  display: none;
}

@media (max-width: 760px) {

  :root {
    --mobile-edge: 1rem;
    --mobile-nav-height: 5.4rem;
  }

  html {
    scroll-padding-bottom:
      calc(var(--mobile-nav-height) + env(safe-area-inset-bottom));
  }

  body {
    min-width: 0;
    overflow-x: hidden;
    padding-bottom:
      calc(var(--mobile-nav-height) + env(safe-area-inset-bottom));
  }

  .app-shell {
    width: 100%;
    min-height: 100dvh;
    overflow: clip;
  }

  .sidebar {
    display: none !important;
  }

  .workspace-main {
    width: 100%;
    min-width: 0;
    margin-left: 0 !important;
  }

  /* TOPBAR */

  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;

    height: 4rem;
    padding: 0 var(--mobile-edge);

    background:
      color-mix(in srgb, var(--surface) 88%, transparent);

    border-bottom:
      1px solid color-mix(in srgb, var(--border) 82%, transparent);

    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
  }

  .mobile-menu {
    display: inline-flex !important;
  }

  .breadcrumb {
    gap: .5rem;
  }

  .breadcrumb-home,
  .breadcrumb > svg {
    display: none;
  }

  .breadcrumb > span:last-child {
    font-family: 'Manrope Variable', sans-serif;
    font-size: .82rem;
    font-weight: 700;
  }

  .topbar-actions {
    gap: .1rem;
  }

  .topbar-divider {
    display: none;
  }

  .global-search,
  .theme-toggle,
  .notification-button,
  .mobile-menu {
    width: 2.65rem;
    height: 2.65rem;
    min-width: 2.65rem;
    min-height: 2.65rem;

    border-radius: 999px;
  }

  .global-search {
    justify-content: center;
    padding: 0;

    border: 0;
    background: transparent;
  }

  .global-search > span,
  .global-search kbd {
    display: none;
  }

  .topbar-avatar {
    width: 2.2rem;
    height: 2.2rem;

    margin-left: .15rem;
  }

  /* CONTENT */

  .content {
    width: 100%;
    max-width: none;

    margin: 0;

    padding:
      1rem
      var(--mobile-edge)
      1.75rem;
  }

  .view-content {
    gap: .85rem;
  }

  /* BANNER */

  .mode-banner {
    margin-bottom: 1.15rem;

    padding: .72rem .8rem;

    border-radius: .85rem;
  }

  .mode-description {
    display: none;
  }

  /* PAGE HEADING */

  .page-heading {
    display: block;

    margin-bottom: 1.2rem;
  }

  .eyebrow {
    margin-bottom: .35rem;

    font-size: .54rem;
    letter-spacing: .12em;
  }

  h1 {
    max-width: 95%;

    font-size: clamp(1.8rem, 8vw, 2.25rem);
    line-height: 1.07;
    letter-spacing: -.055em;
  }

  .page-description {
    max-width: 96%;

    margin-top: .55rem;

    font-size: .77rem;
    line-height: 1.55;
  }

  .heading-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0,1fr));

    width: 100%;

    margin-top: 1rem;
  }

  .heading-actions .button {
    width: 100%;
    min-height: 2.8rem;

    border-radius: .75rem;
  }

  /* FILTERS */

  .filter-bar {
    display: block;

    margin:
      0
      calc(var(--mobile-edge) * -1)
      .9rem;

    padding:
      .1rem
      var(--mobile-edge)
      .9rem;

    overflow: hidden;
  }

  .filter-controls {
    display: flex;
    flex-wrap: nowrap;

    gap: .55rem;

    overflow-x: auto;

    padding-bottom: .2rem;

    scrollbar-width: none;
  }

  .filter-controls::-webkit-scrollbar {
    display: none;
  }

  .select-control {
    flex: 0 0 auto;

    min-height: 2.55rem;

    border-radius: .72rem;
  }

  .select-control select {
    font-size: .7rem;
  }

  .date-range {
    display: none;
  }

  .refresh-control {
    margin-top: .5rem;
  }

  /* KPI */

  .metrics-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: .65rem;
  }

  .metric-card {
    min-height: 8.25rem;

    padding: .9rem;

    border-radius: 1rem;

    box-shadow:
      0 1px 2px rgba(0,0,0,.02),
      0 10px 30px rgba(0,0,0,.035);
  }

  .metric-label {
    font-size: .61rem;
    line-height: 1.3;
  }

  .metric-value {
    margin: .65rem 0 .45rem;

    font-size: clamp(1.2rem, 6vw, 1.65rem);
    line-height: 1.1;
  }

  .metric-bottom {
    flex-wrap: wrap;

    font-size: .53rem;
    line-height: 1.35;
  }

  /* PANELS */

  .panel {
    border-radius: 1rem;
  }

  .analytics-grid,
  .operations-grid,
  .settings-grid,
  .source-notes {
    grid-template-columns: 1fr !important;
  }

  .panel-heading h2 {
    font-size: 1rem;
  }

  .panel-heading p {
    font-size: .67rem;
    line-height: 1.5;
  }

  /* PROJECTS */

  .project-grid {
    grid-template-columns: 1fr !important;
  }

  .project-card,
  .new-project-card {
    min-height: 0;

    border-radius: 1rem;
  }

  .project-card {
    padding: 1rem;
  }

  /* TOOLBARS */

  .list-toolbar,
  .table-tools {
    display: grid !important;
    grid-template-columns: 1fr !important;

    gap: .65rem;
  }

  .tabs {
    max-width: 100%;

    overflow-x: auto;

    scrollbar-width: none;
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  .search-input {
    width: 100%;
  }

  /* SOURCES */

  .source-hero {
    grid-template-columns: 1fr !important;

    padding: 1.2rem !important;

    border-radius: 1rem;
  }

  .source-flow {
    display: none !important;
  }

  .source-row {
    display: grid !important;
    grid-template-columns: auto 1fr;

    gap: .8rem;
  }

  .source-row > .badge,
  .source-row > .button {
    grid-column: 2;

    justify-self: start;
  }

  /* TABLE */

  .table-scroll {
    width: calc(100% + 2rem);

    margin-left: -1rem;

    padding:
      0
      1rem
      .4rem;

    overflow-x: auto;

    -webkit-overflow-scrolling: touch;
  }

  table {
    min-width: 42rem;
  }

  th,
  td {
    white-space: nowrap;
  }

  /* ALERTS */

  .alert-summary {
    grid-template-columns:
      repeat(3, minmax(0,1fr)) !important;

    gap: .5rem;
  }

  .alert-summary > div {
    min-width: 0;

    padding: .8rem .45rem;

    border-radius: .9rem;
  }

  .alert-summary strong {
    font-size: 1.2rem;
  }

  .alert-summary > div > span:last-child {
    font-size: .52rem;
    line-height: 1.25;
    text-align: center;
  }

  /* TOUCH */

  .button,
  .icon-button,
  .tabs button {
    min-height: 2.75rem;
  }

  .page-footer {
    display: none !important;
  }

  /* MOBILE DOCK */

  .mobile-dock-shell {
    position: fixed;

    z-index: 100;

    left: 0;
    right: 0;
    bottom: 0;

    display: block;

    padding:
      0
      .65rem
      max(.55rem, env(safe-area-inset-bottom));

    pointer-events: none;
  }

  .mobile-dock {
    position: relative;

    display: grid;
    grid-template-columns:
      1fr
      4.2rem
      1fr;

    align-items: end;

    width: 100%;
    max-width: 31rem;
    height: 4.3rem;

    margin: 0 auto;

    border:
      1px solid
      color-mix(in srgb, var(--border) 75%, transparent);

    border-radius: 1.3rem;

    background:
      color-mix(
        in srgb,
        var(--surface) 92%,
        transparent
      );

    box-shadow:
      0 18px 55px rgba(0,0,0,.18);

    backdrop-filter:
      blur(24px)
      saturate(180%);

    -webkit-backdrop-filter:
      blur(24px)
      saturate(180%);

    pointer-events: auto;
  }

  .mobile-dock-side {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0,1fr));

    height: 100%;
  }

  .mobile-dock-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    gap: .15rem;

    color: var(--muted);

    font-size: .55rem;
    font-weight: 600;

    transition:
      color .18s ease,
      transform .18s ease;
  }

  .mobile-dock-item:active {
    transform: scale(.92);
  }

  .mobile-dock-item.is-active {
    color: var(--accent);
  }

  .mobile-dock-icon {
    position: relative;

    display: grid;
    place-items: center;

    width: 2.5rem;
    height: 1.8rem;
  }

  .mobile-dock-icon svg {
    position: relative;
    z-index: 2;
  }

  .mobile-dock-active {
    position: absolute;

    inset: -.15rem 0;

    border-radius: 999px;

    background: var(--accent-soft);
  }

  .mobile-dock-badge {
    position: absolute;

    z-index: 4;

    top: -.3rem;
    right: -.1rem;

    display: grid;
    place-items: center;

    min-width: 1.05rem;
    height: 1.05rem;

    padding: 0 .2rem;

    border: 2px solid var(--surface);
    border-radius: 999px;

    background: var(--accent);
    color: white;

    font-size: .47rem;
    font-weight: 800;
  }

  .mobile-dock-action-wrap {
    position: relative;

    height: 100%;

    pointer-events: none;
  }

  .mobile-dock-action {
    position: absolute;

    top: -1.25rem;
    left: 50%;

    display: grid;
    place-items: center;

    width: 3.65rem;
    height: 3.65rem;

    transform: translateX(-50%);

    border:
      .3rem solid
      color-mix(
        in srgb,
        var(--surface) 94%,
        transparent
      );

    border-radius: 1.15rem;

    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--accent) 88%, white),
        var(--accent-hover)
      );

    color: white;

    box-shadow:
      0 10px 25px
      color-mix(
        in srgb,
        var(--accent) 34%,
        transparent
      );

    pointer-events: auto;
  }

  .mobile-dock-action-label {
    position: absolute;

    left: 50%;
    bottom: .4rem;

    transform: translateX(-50%);

    color: var(--muted);

    font-size: .55rem;
    font-weight: 600;
  }

  /* TOAST */

  .toast {
    left: 50% !important;
    right: auto !important;

    bottom:
      calc(
        var(--mobile-nav-height) +
        .8rem +
        env(safe-area-inset-bottom)
      ) !important;

    width: calc(100vw - 2rem);
    max-width: 25rem;

    transform: translateX(-50%);
  }
}

@media (max-width: 390px) {
  :root {
    --mobile-edge: .8rem;
  }

  .metrics-grid {
    gap: .5rem;
  }

  .metric-card {
    padding: .8rem;
  }

  .metric-value {
    font-size: 1.18rem;
  }

  .mobile-dock-shell {
    padding-left: .4rem;
    padding-right: .4rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
  }
}